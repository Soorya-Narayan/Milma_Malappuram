# Copy this file to .env and adjust as needed.
# .env is git-ignored; .env.example is committed.

# Where the SQLite DB + WAL files live inside the container.
# Backed by the named Docker volume `aime_data`.
DATA_DIR=/data

# Logging verbosity for the backend app and uvicorn.
# One of: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Container timezone. Affects log timestamps and the daily 03:00
# retention job. The DB always stores UTC milliseconds.
TZ=Asia/Kolkata

# Only used if the optional Caddy reverse proxy is enabled.
# DASHBOARD_DOMAIN=aime.example.com
# DASHBOARD_USER=operator
# Generate with: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'yourpw'
# DASHBOARD_PASSWORD_HASH='$2a$14$...'
